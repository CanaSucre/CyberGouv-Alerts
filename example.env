# Do not commit this file to your repository, it contains sensitive information.
#
# Rename this file to .env and fill in the values for your environment.
# The .env file is already in the .gitignore file, so it will not be committed to your repository.

# Application environment: 'dev' or 'prod'
APP_ENV=prod

# ------------------------------------------------------------------
# Database configuration
# ------------------------------------------------------------------
# Supported drivers: mysql (also used for MariaDB), pgsql, sqlite
#
# Variables used by each driver:
#   mysql  : DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS, DB_CHARSET (all required)
#   pgsql  : DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS
#   sqlite : DB_NAME only (the other DB_* variables are ignored)
#
# The variable must be present, but DB_PASS may be left empty
# (e.g. a local development database without a password).
DB_DRIVER=

# Server address (mysql, pgsql). Ignored by sqlite.
DB_HOST=

# Default ports: 3306 for mysql, 5432 for pgsql. Ignored by sqlite.
DB_PORT=

# mysql, pgsql : database name
# sqlite : path to the database file, relative to the project root
#          (e.g. database/app.db) or absolute. ':memory:' is also accepted.
DB_NAME=

# Credentials (mysql, pgsql). Ignored by sqlite.
DB_USER=
DB_PASS=

# Required for mysql: utf8mb4 is recommended.
# Ignored by pgsql and sqlite (may be left empty).
# Only letters, digits and underscores are allowed.
DB_CHARSET=

# ------------------------------------------------------------------
# Link to the CERT alerts JSON feed
# ------------------------------------------------------------------
API_LINK=https://www.cert.cyber.gouv.fr/
API_ALL_ALERTS=alerte/json/
#   :id to be replaced with the alert ID
API_ALERTS_BY_ID=alerte/:id/json/