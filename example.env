# Do not commit this file to your repository, it contains sensitive information.
#
# Rename this file to .env and fill in the values for your environment.
# The .env file is already in the .gitignore file, so it will not be committed to your repository.

# 'prod' or 'dev'
APP_ENV=prod

# Database configuration
#
#   mysql, pgsql, sqlite, sqlsrv...
DB_DRIVER=
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=